{
  "name": "behavioral-health-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first behavioral health CRM prototype for referrals, inquiries, follow-ups, marketing, readiness, and integrations.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "build:emit": "tsc -p tsconfig.build.json",
    "start:crm": "npm run build:emit && node dist/behavioralHealthCrm/server.js",
    "start:crm:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\Start-BehavioralHealthCrm.ps1 -NoBrowser",
    "stop:crm": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\Stop-BehavioralHealthCrm.ps1",
    "start:consulting": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\Start-AIConsulting.ps1 -NoBrowser",
    "start:consulting:foreground": "npm run build:emit && node dist/consultingApp/server.js",
    "stop:consulting": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\Stop-AIConsulting.ps1",
    "start:trading": "npm run build:emit && node dist/tradingApp/server.js",
    "prospects:va": "npm run build:emit && node dist/prospecting/cli/findVirginiaProspects.js",
    "start:test": "npm run build:emit && node dist/dev/mockServer.js",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
