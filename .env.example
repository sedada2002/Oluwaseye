# Copy to .env (never commit .env). Read only by the backend; never ship to a client bundle.
NASDAQ_DATA_LINK_API_KEY=
# Optional: where downloaded data is cached (sharadar/, edgar/, alpaca/)
QUANTFLOW_CACHE_DIR=.cache

# --- Free data path (quantflow --source free) ---
# SEC requires a name + contact email in the User-Agent of every request
SEC_USER_AGENT=
# Alpaca market data (paper-trading keys work): https://app.alpaca.markets
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# sip (all exchanges) or iex; switch to iex if Alpaca rejects sip on your plan
ALPACA_DATA_FEED=sip
